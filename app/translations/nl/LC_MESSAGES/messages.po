#: app/init.py:99
msgid "First flight of Concorde — André Turcat at the controls, Toulouse (1969)"
msgstr "Eerste vlucht van de Concorde — André Turcat aan de besturing, Toulouse (1969)"

#: app/init.py:105
msgid "Charles Lindbergh lands at Le Bourget — first solo transatlantic flight (1927)"
msgstr "Charles Lindbergh landt op Le Bourget — eerste solo transatlantische vlucht (1927)"

#: app/init.py:112
msgid "Louis Blériot crosses the English Channel — first crossing by airplane (1909)"
msgstr "Louis Blériot steekt het Kanaal over — eerste oversteek per vliegtuig (1909)"

#: app/init.py:119
msgid "Pilâtre de Rozier & d'Arlandes — first manned free balloon flight, Paris (1783)"
msgstr "Pilâtre de Rozier en d'Arlandes — eerste bemande vrije ballonvlucht, Parijs (1783)"

#: app/init.py:125
msgid "First flight: 17 Dec 1903 — 12 seconds, 37 metres. (Wright Brothers)"
msgstr "Eerste vlucht: 17 december 1903 — 12 seconden, 37 meter. (gebroeders Wright)"

#: app/init.py:182
#, python-format
msgid "🎉 Today marks one year since your first solo flight!"
msgid_plural "🎉 Today marks %(n)s years since your first solo flight!"
msgstr[0] "🎉 Het is vandaag één jaar geleden dat u uw eerste solovlucht maakte!"
msgstr[1] "🎉 Het is vandaag %(n)s jaar geleden dat u uw eerste solovlucht maakte!"

#: app/init.py:189
msgid "🎉 Today is the anniversary of your first solo flight!"
msgstr "🎉 Vandaag is het de verjaardag van uw eerste solovlucht!"

#: app/init.py:195
#, python-format
msgid "🎉 Today marks one year since you earned your PPL!"
msgid_plural "🎉 Today marks %(n)s years since you earned your PPL!"
msgstr[0] "🎉 Het is vandaag één jaar geleden dat u uw PPL behaalde!"
msgstr[1] "🎉 Het is vandaag %(n)s jaar geleden dat u uw PPL behaalde!"

#: app/init.py:201
msgid "🎉 Today is the anniversary of your PPL!"
msgstr "🎉 Vandaag is het de verjaardag van uw PPL!"

#: app/init.py:1184
#, python-format
msgid "This upload is too large (maximum %(mb)s MB in total). Please upload the files in smaller batches."
msgstr "Deze upload is te groot (maximaal %(mb)s MB in totaal). Upload de bestanden in kleinere delen."

#: app/init.py:1211
msgid "Some text entered is too long, so nothing was saved. Please shorten it and try again."
msgstr "Een ingevoerde tekst is te lang, dus er is niets opgeslagen. Maak hem korter en probeer het opnieuw."

#: app/flights/form_parsing.py:459 app/init.py:1216
msgid "A number entered is far too large, so nothing was saved. Please check the values and try again."
msgstr "Een ingevoerd getal is veel te groot, dus er is niets opgeslagen. Controleer de waarden en probeer het opnieuw."

#: app/init.py:1269
msgid "The sign-in form had expired. Please sign in again."
msgstr "Het aanmeldformulier was verlopen. Meld u opnieuw aan."

