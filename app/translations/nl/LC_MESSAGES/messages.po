msgstr "Hele groep, inclusief geschiedenis"

#: app/templates/passports/group_members.html:17
#: app/templates/places/collection_settings.html:9
msgid "Remove member"
msgstr "Lid verwijderen"

#: app/templates/passports/group_members.html:19
