msgstr "Bezoekfrequentie (alleen gepubliceerde aantallen)"

#: app/templates/passports/public_view.html:15
msgid "Download public data (JSON)"
msgstr "Openbare gegevens downloaden (JSON)"

#: app/templates/passports/public_view.html:18
msgid "Passport map"
msgstr "Paspoortkaart"

#: app/templates/passports/public_view.html:19
msgid "First visit month"
msgstr "Maand van het eerste bezoek"

