#: app/templates/passports/group_members.html:7
msgid "Group ownership"
msgstr "Groepseigendom"

#: app/templates/passports/group_members.html:8
msgid "The selected participant must accept within seven days. Transfer covers this group and its group editions, without changing private linked passports, personal evidence, vouchers or aircraft permissions."
msgstr "De geselecteerde deelnemer moet binnen zeven dagen accepteren. De overdracht omvat deze groep en de groepsedities, zonder privépaspoorten, persoonlijk bewijs, vouchers of vliegtuigrechten te wijzigen."

#: app/templates/passports/group_members.html:9
#, python-format
msgid "Ownership offered to %(name)s."
msgstr "Eigendom aangeboden aan %(name)s."

#: app/templates/passports/group_members.html:10
msgid "Accept group ownership"
msgstr "Groepseigendom accepteren"

#: app/templates/passports/group_members.html:10
msgid "Decline ownership"
msgstr "Eigendom weigeren"

#: app/templates/passports/group_members.html:11
