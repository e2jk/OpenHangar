#: app/aircraft/co_owner_form_parsing.py:73
msgid "Invalid owner selection."
msgstr "Sélection de propriétaire invalide."

#: app/aircraft/co_owner_form_parsing.py:76
msgid "Each owner can only appear once."
msgstr "Chaque propriétaire ne peut apparaître qu'une seule fois."

#: app/aircraft/co_owner_form_parsing.py:89
msgid "Share for each owner must be greater than 0, at most 100, and have at most 2 decimal places."
msgstr "La part de chaque propriétaire doit être supérieure à 0, au maximum 100, et comporter au plus 2 décimales."

#: app/aircraft/co_owner_form_parsing.py:98
msgid "Buy-in amount must be a non-negative number."
msgstr "Le montant de mise de fonds doit être un nombre positif ou nul."

#: app/aircraft/co_owner_form_parsing.py:107
#, python-format
msgid "Share percentages must sum to exactly 100%%."
msgstr "Les pourcentages de parts doivent totaliser exactement 100 %%."

#: app/aircraft/co_owner_form_parsing.py:115
msgid "Billing start date must be a valid date (YYYY-MM-DD)."
msgstr "La date de début de facturation doit être une date valide (AAAA-MM-JJ)."

#: app/aircraft/co_owner_form_parsing.py:122
msgid "Hourly rate must be a non-negative number."
msgstr "Le tarif horaire doit être un nombre positif ou nul."

#: app/aircraft/co_owner_form_parsing.py:143
msgid "Reserve contribution (hourly) must be a non-negative number."
msgstr "La contribution (horaire) au fonds de réserve doit être un nombre positif ou nul."

#: app/aircraft/co_owner_form_parsing.py:153
msgid "Reserve contribution (monthly) must be a non-negative number."
msgstr "La contribution (mensuelle) au fonds de réserve doit être un nombre positif ou nul."

#: app/aircraft/co_owner_form_parsing.py:159
msgid "Set either an hourly or a monthly reserve contribution, not both."
msgstr "Définissez soit une contribution horaire, soit une contribution mensuelle au fonds de réserve, pas les deux."

#: app/aircraft/routes.py:467
msgid "Registration is required."
msgstr "L'immatriculation est obligatoire."

