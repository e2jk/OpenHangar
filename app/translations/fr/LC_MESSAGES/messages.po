#: app/init.py:99
msgid "First flight of Concorde — André Turcat at the controls, Toulouse (1969)"
msgstr "Premier vol du Concorde — André Turcat aux commandes, Toulouse (1969)"

#: app/init.py:105
msgid "Charles Lindbergh lands at Le Bourget — first solo transatlantic flight (1927)"
msgstr "Charles Lindbergh atterrit au Bourget — première traversée transatlantique en solo (1927)"

#: app/init.py:112
msgid "Louis Blériot crosses the English Channel — first crossing by airplane (1909)"
msgstr "Louis Blériot traverse la Manche — première traversée en avion (1909)"

#: app/init.py:119
msgid "Pilâtre de Rozier & d'Arlandes — first manned free balloon flight, Paris (1783)"
msgstr "Pilâtre de Rozier et d'Arlandes — premier vol habité en ballon libre, Paris (1783)"

#: app/init.py:125
msgid "First flight: 17 Dec 1903 — 12 seconds, 37 metres. (Wright Brothers)"
msgstr "Premier vol : 17 décembre 1903 — 12 secondes, 37 mètres. (frères Wright)"

#: app/init.py:182
#, python-format
msgid "🎉 Today marks one year since your first solo flight!"
msgid_plural "🎉 Today marks %(n)s years since your first solo flight!"
msgstr[0] "🎉 Cela fait un an que vous avez effectué votre premier vol solo !"
msgstr[1] "🎉 Cela fait %(n)s ans que vous avez effectué votre premier vol solo !"

#: app/init.py:189
msgid "🎉 Today is the anniversary of your first solo flight!"
msgstr "🎉 Aujourd'hui, c'est l'anniversaire de votre premier vol solo !"

#: app/init.py:195
#, python-format
msgid "🎉 Today marks one year since you earned your PPL!"
msgid_plural "🎉 Today marks %(n)s years since you earned your PPL!"
msgstr[0] "🎉 Cela fait un an que vous avez obtenu votre PPL !"
msgstr[1] "🎉 Cela fait %(n)s ans que vous avez obtenu votre PPL !"

#: app/init.py:201
msgid "🎉 Today is the anniversary of your PPL!"
msgstr "🎉 Aujourd'hui, c'est l'anniversaire de l'obtention de votre PPL !"

#: app/init.py:1184
#, python-format
msgid "This upload is too large (maximum %(mb)s MB in total). Please upload the files in smaller batches."
msgstr "Cet envoi est trop volumineux (maximum %(mb)s Mo au total). Veuillez envoyer les fichiers en plusieurs fois."

#: app/init.py:1211
msgid "Some text entered is too long, so nothing was saved. Please shorten it and try again."
msgstr "Un texte saisi est trop long, rien n’a donc été enregistré. Veuillez le raccourcir et réessayer."

