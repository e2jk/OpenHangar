#: app/flights/form_parsing.py:110
msgid "Date must be a valid date (YYYY-MM-DD)."
msgstr "La date doit être une date valide (AAAA-MM-JJ)."

#: app/flights/form_parsing.py:115
msgid "Departure airfield is required."
msgstr "Le terrain de départ est obligatoire."

#: app/flights/form_parsing.py:117
msgid "Arrival airfield is required."
msgstr "Le terrain d'arrivée est obligatoire."

#: app/flights/form_parsing.py:124
msgid "Pilot (crew 1) name is required."
msgstr "Le nom du pilote (équipage 1) est obligatoire."

#: app/flights/form_parsing.py:134
msgid "Departure time must be a valid UTC time (HH:MM)."
msgstr "L'heure de départ doit être une heure UTC valide (HH:MM)."

#: app/flights/form_parsing.py:139
msgid "Arrival time must be a valid UTC time (HH:MM)."
msgstr "L'heure d'arrivée doit être une heure UTC valide (HH:MM)."

#: app/flights/form_parsing.py:151
msgid "Takeoff time must be a valid UTC time (HH:MM)."
msgstr "L'heure de décollage doit être une heure UTC valide (HH:MM)."

#: app/flights/form_parsing.py:156
msgid "Landing time must be a valid UTC time (HH:MM)."
msgstr "L'heure d'atterrissage doit être une heure UTC valide (HH:MM)."

#: app/flights/form_parsing.py:176
msgid "Counter value must be a positive number (decimal hours or H:MM)."
msgstr "La valeur du compteur doit être un nombre positif (heures décimales ou H:MM)."

#: app/flights/form_parsing.py:195
msgid "Flight counter end must not be less than flight counter start."
msgstr "La fin du compteur de vol ne doit pas être inférieure à son début."

#: app/flights/form_parsing.py:203
msgid "Engine counter end must not be less than engine counter start."
msgstr "La fin du compteur moteur ne doit pas être inférieure à son début."

#: app/flights/form_parsing.py:227
#, python-format
msgid "Engine time from the counters (%(counters)s h) doesn't match the departure/arrival times (%(clock)s h) — check for a data entry mistake."
msgstr "Le temps moteur calculé à partir des compteurs (%(counters)s h) ne correspond pas aux heures de départ/arrivée (%(clock)s h) — vérifiez qu'il n'y a pas d'erreur de saisie."

#: app/flights/form_parsing.py:279
#, python-format
msgid "Flight time from the counters (%(counters)s h) doesn't match the takeoff/landing times (%(clock)s h) — check for a data entry mistake."
msgstr "Le temps de vol calculé à partir des compteurs (%(counters)s h) ne correspond pas aux heures de décollage/atterrissage (%(clock)s h) — vérifiez qu'il n'y a pas d'erreur de saisie."

#: app/flights/form_parsing.py:301
msgid "Passenger count must be a non-negative integer."
msgstr "Le nombre de passagers doit être un entier positif ou nul."

#: app/flights/form_parsing.py:312
msgid "Landing count must be a non-negative integer."
msgstr "Le nombre d'atterrissages doit être un entier positif ou nul."

#: app/flights/form_parsing.py:325
msgid "Fuel quantity added before the flight must be a non-negative number."
msgstr "La quantité de carburant ajoutée avant le vol doit être un nombre positif ou nul."

#: app/flights/form_parsing.py:340
msgid "Fuel quantity added after the flight must be a non-negative number."
msgstr "La quantité de carburant ajoutée après le vol doit être un nombre positif ou nul."

#: app/flights/form_parsing.py:353
msgid "Fuel remaining must be a non-negative number."
msgstr "Le carburant restant doit être un nombre positif ou nul."

#: app/flights/form_parsing.py:374
#, python-format
msgid "Fuel remaining in tank %(tank)s must be a non-negative number."
msgstr "Le carburant restant dans le réservoir %(tank)s doit être un nombre positif ou nul."

#: app/flights/form_parsing.py:394
msgid "Oil added before the flight must be a non-negative number."
msgstr "L'huile ajoutée avant le vol doit être un nombre positif ou nul."

#: app/flights/form_parsing.py:407
msgid "Oil added after the flight must be a non-negative number."
msgstr "L'huile ajoutée après le vol doit être un nombre positif ou nul."

#: app/flights/routes.py:167
#, python-format
msgid "One subtotal row skipped."
msgid_plural "%(n)d subtotal rows skipped."
