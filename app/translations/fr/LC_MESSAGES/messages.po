#: app/aircraft/routes.py:372
msgid "Registration is required."
msgstr "L'immatriculation est obligatoire."

#: app/aircraft/routes.py:378
#, python-format
msgid "%(reg)s is already used by another aircraft in this hangar (registrations that only differ by spaces or slashes still count as the same, since they'd otherwise share a URL)."
msgstr "%(reg)s est déjà utilisé par un autre avion de ce hangar (les immatriculations qui ne diffèrent que par des espaces ou des barres obliques sont considérées comme identiques, car elles partageraient sinon la même URL)."

